# ============================================================
# TecSource · exemplo de configuração do backend
# Copie para server/.env e preencha os valores reais.
# Em produção (Render) essas variáveis são cadastradas no painel.
# ============================================================

# --- Servidor ---
# O Render injeta PORT automaticamente; 3000 é o padrão local.
# PORT=3000

# --- Banco de dados (Supabase) ---
# Project Settings → Database → Connection string → URI
# Prefira a porta 6543 (Connection Pooler) para a API no Render.
# Se a senha tiver @ # / :, codifique com encodeURIComponent.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase e Render exigem TLS. Deixe true em produção.
DATABASE_SSL=true

# Fuso das janelas de "hoje / 7 / 30 dias" (funções SQL).
# DB_TIMEZONE=America/Sao_Paulo

# --- Banco local (alternativa ao Supabase) ---
# docker compose up -d
# DATABASE_URL=postgresql://postgres:tecsource@localhost:5432/tecsource
# DATABASE_SSL=false

# --- CORS ---
# Origens autorizadas a chamar a API (frontend no GitHub Pages).
# Lista separada por vírgula, sem barra no fim.
# Ex.: https://usuario.github.io
# Ausente ou "*" libera qualquer origem (a API não usa cookies).
ORIGENS_PERMITIDAS=*

# --- Scripts de banco ---
# CONFIRMAR_RESET=1 evita confirmação interativa em db:reset/feira:reset
# CONFIRMAR_RESET=1
